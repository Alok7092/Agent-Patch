# ============================================================
# SNAP (SAP Security Note AI Patch) — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values for your environment.
# Variables marked [REQUIRED] must be set before the app can run analysis.
# Variables marked [OPTIONAL] enable additional features.
# ============================================================

AGENT_PATCH_MODE=local
SECRET_KEY=change-me-in-production

# ------------------------------------------------------------
# AI Model Gateway  [REQUIRED for analysis]
# ------------------------------------------------------------
# SNAP calls an OpenAI-compatible /v1/chat/completions endpoint.
# If your environment already runs a shared AI gateway (LiteLLM, Azure
# OpenAI, AWS Bedrock proxy, etc.), point to the same endpoint other
# agents use — no separate setup needed.
#
#   AI_BASE_URL   — gateway root URL (no trailing slash, no /v1 suffix)
#   AI_API_KEY    — bearer token for the gateway
#   AI_MODEL      — model identifier the gateway understands
#                   (default: bedrock.anthropic.claude-sonnet-4-5)
#   AI_COMPLEX_MODEL — model for CVSS >= 9.0 notes (default: same as AI_MODEL)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_COMPLEX_MODEL=

# ------------------------------------------------------------
# SAP Portal Credentials  [REQUIRED for "Fetch Latest" feature]
# ------------------------------------------------------------
# Used by the Playwright-based MCP scraper to log into me.sap.com
# and pull the latest security notes automatically.
# Not needed if you only upload Excel/CSV files manually.
SAP_USERNAME=
SAP_PASSWORD=

# SAP MCP Server paths (adjust to your Node.js / server location)
SAP_MCP_NODE_PATH=
SAP_MCP_SERVER_PATH=

# ------------------------------------------------------------
# SAP API  [OPTIONAL — alternative to MCP scraping]
# ------------------------------------------------------------
# Direct SAP API access, if your organization has API keys.
SAP_API_URL=
SAP_API_KEY=

# ------------------------------------------------------------
# Corporate Proxy  [OPTIONAL]
# ------------------------------------------------------------
HTTPS_PROXY=

# ------------------------------------------------------------
# AWS Bedrock  [OPTIONAL — only if calling Bedrock directly]
# ------------------------------------------------------------
# Not needed when using a shared AI gateway that handles Bedrock auth.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ------------------------------------------------------------
# Azure AD  [OPTIONAL — only for AGENT_PATCH_MODE=azure]
# ------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
